<UserControl x:Class="PlayniteConnect.PlayniteConnectSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PlayniteConnect">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <GroupBox Header="MQTT connection" BorderThickness="2"><StackPanel Margin="8">
                <TextBlock Text="Client ID:" /><TextBox Text="{Binding Settings.ClientId}" />
                <TextBlock Text="Server address:" /><TextBox Text="{Binding Settings.ServerAddress}" />
                <TextBlock Text="Server port:" /><TextBox PreviewTextInput="NumberValidationTextBox" Text="{Binding Settings.Port, Converter={local:NullableIntToStringConverter}, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox IsChecked="{Binding Settings.UseSecureConnection}" Content="Secure TCP connection" Margin="0,8,0,0" />
                <TextBlock Text="Certificate path:" /><TextBox Text="{Binding Settings.CertificatePath}" />
                <TextBlock Text="Username:" /><TextBox Text="{Binding Settings.Username}" />
                <TextBlock Text="Password:" /><PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_OnPasswordChanged" />
            </StackPanel></GroupBox>
            <GroupBox Header="Library sync" BorderThickness="2" Margin="0,8,0,0"><StackPanel Margin="8">
                <TextBlock Text="Device ID:" ToolTip="Used in playnite/&lt;device-id&gt;/library/... MQTT topics." /><TextBox Text="{Binding Settings.DeviceId}" />
            </StackPanel></GroupBox>
            <GroupBox Header="Cover API" BorderThickness="2" Margin="0,8,0,0"><StackPanel Margin="8">
                <CheckBox IsChecked="{Binding Settings.CoverApiEnabled}" Content="Enable local cover API" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrushDarker}">Disabled by default. When enabled, the API starts on localhost only. Home Assistant fetches covers with the bearer token below; browsers never receive it.</TextBlock>
                <TextBlock Text="API port:" Margin="0,8,0,0" /><TextBox PreviewTextInput="NumberValidationTextBox" Text="{Binding Settings.CoverApiPort, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Home Assistant IPv4 address:" Margin="0,8,0,0" /><TextBox Text="{Binding Settings.CoverApiHomeAssistantAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="Only this address is allowed through the Windows Firewall rule when network access is enabled." />
                <Button Content="Enable network access for Home Assistant" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="10,4" Click="EnableCoverApiNetwork_Click" />
                <TextBlock Text="Bearer token:" Margin="0,8,0,0" /><DockPanel><Button DockPanel.Dock="Right" Content="Copy" Margin="8,0,0,0" Padding="10,4" Click="CopyCoverApiToken_Click" /><TextBox Text="{Binding Settings.CoverApiToken}" IsReadOnly="True" /></DockPanel>
                <Button Content="Regenerate token" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="10,4" Click="RegenerateCoverApiToken_Click" />
            </StackPanel></GroupBox>
            <GroupBox Header="Display" BorderThickness="2" Margin="0,8,0,0"><StackPanel Margin="8">
                <CheckBox IsChecked="{Binding Settings.ShowProgress}" Content="Show connection progress on startup" />
                <CheckBox IsChecked="{Binding Settings.ShowStatusChanged}" Content="Show connection status messages" />
                <CheckBox IsChecked="{Binding Settings.Notifications}" Content="Show connection notifications" />
            </StackPanel></GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>